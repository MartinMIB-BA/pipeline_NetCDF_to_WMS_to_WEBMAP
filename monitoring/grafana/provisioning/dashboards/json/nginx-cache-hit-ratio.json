{
  "title": "Nginx GWC Cache Hit Ratio",
  "uid": "nginx-cache-hit-ratio",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "tags": ["cache", "nginx", "gwc"],
  "panels": [
    {
      "id": 1,
      "title": "Cache Hit Ratio (selected range)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"nginx\", cache_status=\"HIT\"}[$__range])) / sum(count_over_time({job=\"nginx\", cache_status=~\"HIT|MISS|BYPASS|EXPIRED|STALE|UPDATING|REVALIDATED\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "HIT requests divided by all requests that actually passed through a proxy_cache zone (excludes non-cacheable paths like plain WMS/admin, logged as cache=-). Only /geoserver/gwc/ is cached today — see the Coastal WMS chat thread for the plan to extend this to static/points layers."
    },
    {
      "id": 2,
      "title": "Cacheable requests (last 24h)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"nginx\", cache_status=~\"HIT|MISS|BYPASS|EXPIRED|STALE|UPDATING|REVALIDATED\"}[$__range]))",
          "queryType": "instant"
        }
      ]
    },
    {
      "id": 3,
      "title": "Non-cached requests (last 24h)",
      "type": "stat",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({job=\"nginx\", cache_status=\"-\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "description": "Requests to locations with no proxy_cache configured at all (e.g. plain /geoserver/wms, static assets) — not counted as MISS, they never had a chance to be a HIT."
    },
    {
      "id": 4,
      "title": "Request rate by cache status",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" }, "drawStyle": "bars" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (cache_status) (count_over_time({job=\"nginx\"}[$__interval]))",
          "legendFormat": "{{cache_status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Raw counts by cache status (selected range)",
      "type": "table",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (cache_status) (count_over_time({job=\"nginx\"}[$__range]))",
          "queryType": "instant",
          "format": "table"
        }
      ]
    }
  ]
}
